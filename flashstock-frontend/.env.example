# Only the API Gateway origin is needed by the frontend.
# Local: Next's transport rewrite forwards /api/* to Nginx.
FLASHSTOCK_API_BASE_URL=http://localhost:8080
# Vercel: set FLASHSTOCK_API_BASE_URL=https://YOUR_API.execute-api.us-east-1.amazonaws.com
# No Cognito credentials, signing keys or session secrets belong in Vercel.

# Optional direct browser -> gateway mode. Leave empty for the recommended same-origin rewrite.
# Requires backend CORS and suitable cookie domains/SameSite; cross-site cookies may be blocked.
NEXT_PUBLIC_API_BASE_URL=
