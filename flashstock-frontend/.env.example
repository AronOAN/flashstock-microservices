# Local Next.js development (pnpm dev -> http://localhost:3000).
FLASHSTOCK_SITE_URL=http://localhost:3000
FLASHSTOCK_ORDER_ROUTES_ENABLED=false
FLASHSTOCK_API_BASE_URL=
COGNITO_ISSUER_URL=
COGNITO_APP_CLIENT_ID=
# Para la opción Authorization Code + PKCE, usa el output cognito_domain_url.
# Comprueba que el dominio y la página de login administrado estén habilitados.
COGNITO_DOMAIN_URL=
# En Vercel configura FLASHSTOCK_SITE_URL con https://flashstock-microservices.vercel.app.
# Generate with: openssl rand -base64 32 ; NEVER commit .env.local or publish this key
FLASHSTOCK_SESSION_KEY=GENERATE_32_RANDOM_BYTES_AS_BASE64

# Enable LAST, after DB migration, Auth deployment and the three API Gateway routes are healthy.
FLASHSTOCK_ISSUED_TOKENS_ENABLED=false

# Same 32+ byte Base64 secret configured in Auth ECS Secrets Manager. Vercel SERVER only; never NEXT_PUBLIC_.
FLASHSTOCK_BFF_SHARED_SECRET=CONFIGURE_IN_VERCEL_SERVER_ENV
