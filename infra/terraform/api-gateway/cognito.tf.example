# OPCIONAL, no activo: renombra este archivo a cognito.tf solamente cuando
# hayas confirmado permisos cognito-idp:CreateUserPool / CreateUserPoolClient /
# CreateGroup y desees crear un pool nuevo (no duplicar uno existente).
# Esto NO sustituye el permiso IAM de Terraform o el rol de ejecucion de Lambda.
# No configura login UI ni sustituye la autenticacion Spring actual.

resource "aws_cognito_user_pool" "flashstock" {
  name                     = "${var.project_name}-${var.environment}-users"
  username_attributes      = ["email"]
  auto_verified_attributes = ["email"]

  admin_create_user_config {
    allow_admin_create_user_only = true
  }
}

resource "aws_cognito_user_pool_client" "frontend" {
  name                         = "${var.project_name}-${var.environment}-frontend"
  user_pool_id                 = aws_cognito_user_pool.flashstock.id
  generate_secret              = false
  prevent_user_existence_errors = "ENABLED"
  explicit_auth_flows = [
    "ALLOW_REFRESH_TOKEN_AUTH",
    "ALLOW_USER_SRP_AUTH"
  ]
}

resource "aws_cognito_user_group" "user" {
  name         = "USER"
  user_pool_id = aws_cognito_user_pool.flashstock.id
  description  = "Usuarios estandar FlashStock. No concede permisos IAM a Terraform."
}

resource "aws_cognito_user_group" "admin" {
  name         = "ADMIN"
  user_pool_id = aws_cognito_user_pool.flashstock.id
  description  = "Administradores de la aplicacion. No concede permisos IAM a Terraform."
}

resource "aws_apigatewayv2_authorizer" "cognito" {
  api_id           = aws_apigatewayv2_api.flashstock.id
  name             = "${var.project_name}-${var.environment}-jwt"
  authorizer_type  = "JWT"
  identity_sources = ["$request.header.Authorization"]

  jwt_configuration {
    audience = [aws_cognito_user_pool_client.frontend.id]
    issuer   = "https://${aws_cognito_user_pool.flashstock.endpoint}"
  }
}

output "cognito_user_pool_id" {
  value = aws_cognito_user_pool.flashstock.id
}

output "cognito_app_client_id" {
  value = aws_cognito_user_pool_client.frontend.id
}

output "cognito_authorizer_id" {
  value = aws_apigatewayv2_authorizer.cognito.id
}
